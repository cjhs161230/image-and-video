# Copy this file to .env and replace placeholders locally.
# Never commit .env.

IMAGE_VIDEO_HOST=127.0.0.1
IMAGE_VIDEO_PORT=17860
VIDEO_FEATURE_ENABLED=false

DASHSCOPE_API_KEY=sk-YOUR_DASHSCOPE_KEY

MATSCA_DIRECT_BASE_URL=https://img.matsca.com/v1
MATSCA_DIRECT_API_KEY=sk-YOUR_MATSCA_DIRECT_KEY

MATSCA_NATIVE_BASE_URL=https://img.matsca.com/v1
MATSCA_NATIVE_API_KEY=sk-YOUR_MATSCA_NATIVE_KEY

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=sk-YOUR_DEEPSEEK_KEY
DEEPSEEK_MODEL=deepseek-v4-flash
